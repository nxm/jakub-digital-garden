# Bearer token the Claude connector must present. Generate with:
#   openssl rand -hex 32
# Required — the server refuses to start without it.
MCP_AUTH_TOKEN=

# Vault root. Defaults to ../docs relative to this package.
VAULT_PATH=/srv/jakub-digital-garden/docs

# Port the MCP server listens on. Put a TLS-terminating reverse proxy in front.
PORT=8787

# Where moltis saves channel attachments, so a meal photo can be copied into the
# vault without the model naming the file.
MOLTIS_MEDIA_ROOT=/var/lib/moltis/sessions/media/v1

# Records which attachment was already filed. Keep it outside the vault — the
# publisher stages the vault, and this is nobody's business but the server's.
GARDEN_STATE_DIR=/var/lib/garden/state
